  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Genaker/CloudFlare_FPC_Worker/issues"
  },
  "homepage": "https://github.com/Genaker/CloudFlare_FPC_Worker#readme",
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "miniflare": "^3.20241106.1",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "js-crawler": "^0.3.21",
    "node-fetch": "^2.7.0"
  }
