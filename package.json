{
  "name": "cloudflare_fpc_worker",
  "version": "1.0.0",
  "description": "Magento 2 Cloud Flare FPC worker",
  "main": "FPC.js",
  "type": "module",
  "scripts": {
    "generate": "node generate.js",
    "test": "jest --config=jest.config.cjs",
    "test:watch": "jest --config=jest.config.cjs --watch",
    "test:verbose": "jest --config=jest.config.cjs --verbose",
    "test:ci": "jest --config=jest.config.cjs --ci --forceExit --runInBand",
    "test:unit": "vitest run --config vitest.unit.config.js",
    "test:unit:watch": "vitest --config vitest.unit.config.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Genaker/CloudFlare_FPC_Worker.git"
  },
  "keywords": [
